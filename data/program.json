  "shoulder": {
    "name": "Shoulder Flexion",
    "cadence": "1–2×/week",
    "exercises": [
      { "key": "sf-a1-banded-ext-rotation", "order": "A1", "name": "Banded Stretching — External Rotation", "inputType": "check", "prescription": { "reps": "6 + 8s iso", "tempo": "5s contract / 5s relax", "sets": "2–3", "rest": "30s" }, "defaultSets": 3, "note": "On the last rep, remove the band and externally rotate without assistance for the 8s isometric hold.", "videoUrl": "https://www.youtube.com/watch?v=ITCc-DSpgLs" },
      { "key": "sf-a2-prone-db-ext-rotation", "order": "A2", "name": "Prone Dumbbell External Rotation", "inputType": "check", "prescription": { "reps": "5–8", "tempo": "3112", "sets": "2–3", "rest": "60s" }, "defaultSets": 3, "note": "Support elbow on an object level with your shoulder. Torso parallel to the ground.", "videoUrl": "https://www.youtube.com/watch?v=uv0K-rzAMTI&feature=youtu.be" },
      { "key": "sf-b1-pillar-lat-stretch", "order": "B1", "name": "Pillar Lat Stretch", "inputType": "check", "prescription": { "reps": "8", "tempo": "3s contract / 3s relax", "sets": "2–3", "rest": "30s" }, "defaultSets": 3, "note": "Palm toward your grip. Create a long arc along your spine. Push with the bottom hand. Posteriorly tilt the pelvis.", "videoUrl": "https://www.youtube.com/watch?v=Bqge_oSmHE8&feature=youtu.be" },
      { "key": "sf-b2-horiz-db-lower-trap-raise", "order": "B2", "name": "Horizontal Dumbbell Lower Trap Raise", "inputType": "check", "prescription": { "reps": "5–8", "tempo": "3112", "sets": "2–3", "rest": "60s" }, "defaultSets": 3, "note": "Arm comes out at a 30–45° angle to the body. Torso parallel to the ground.", "videoUrl": "https://www.youtube.com/watch?v=WTIbJn_8lVI&feature=youtu.be" },
      { "key": "sf-c1-loaded-pec-stretch", "order": "C1", "name": "Loaded Pec Stretch", "inputType": "check", "prescription": { "reps": "8", "tempo": "3210", "sets": "2–3", "rest": "30s" }, "defaultSets": 3, "note": "Thumb points down. Hand slightly above ear height.", "videoUrl": "https://www.youtube.com/watch?v=CIzKsfsjoyY&feature=youtu.be" },
      { "key": "sf-c2-prone-db-powell-raise", "order": "C2", "name": "Prone Dumbbell Powell Raise", "inputType": "check", "prescription": { "reps": "5–8", "tempo": "3112", "sets": "2–3", "rest": "60s" }, "defaultSets": 3, "note": "Lay face down on a box or bench. Hand inline with your ear at the bottom.", "videoUrl": "https://www.youtube.com/watch?v=dCcEtA32-ko" },
      { "key": "sf-d1-hanging-variation", "order": "D1", "name": "Your Hanging Variation", "inputType": "check", "prescription": { "reps": "30–90s", "tempo": "—", "sets": "2", "rest": "120s" }, "defaultSets": 2, "note": "Use the Mobility & Flexibility Toolkit to find your hanging variation." }
    ]
  },
  "frontSplit": {
    "name": "Front Split",
    "cadence": "1–2×/week",
    "sessionsPerPhase": 8,
    "holdLastPhase": true,
    "source": "MFTK Front Split Program 221 V3",
    "phases": [
      {
        "id": "fs-p1",
        "name": "Front Split Phase 1",
        "equipment": "A bench or box. Blocks or supports.",
        "exercises": [
          { "key": "fs-p1-seated-pike-lift-sl", "order": "A1", "name": "Seated Pike Lift — Single Leg", "inputType": "check", "prescription": { "reps": "8", "tempo": "1114", "sets": "2–3", "rest": "60s+" }, "defaultSets": 3, "measurement": { "type": "text", "label": "Depth" }, "note": "Place your hands forwards at a distance where your leg only lifts a few cm. Push into the floor with your hands." },
          { "key": "fs-p1-couch-stretch-hips-high", "order": "B1", "name": "Couch Stretch — Hips High Hold", "inputType": "check", "prescription": { "reps": "30s", "tempo": "—", "sets": "2–3", "rest": "60s+" }, "defaultSets": 3, "note": "Lean back and posteriorly (backwards) tilt the pelvis." },
          { "key": "fs-p1-front-split-slides", "order": "C1", "name": "Front Split Slides — Back Leg Bent", "inputType": "check", "prescription": { "reps": "30", "tempo": "60 bpm", "sets": "2–3", "rest": "90s+" }, "defaultSets": 3, "measurement": { "type": "text", "label": "Depth" }, "note": "Tempo = 1s in the stretch, 1s release. In 60s you would have 30 touches to your marker." },
          { "key": "fs-p1-kneeling-needle", "order": "C2", "name": "Kneeling Needle", "inputType": "check", "prescription": { "reps": "8", "tempo": "1114", "sets": "2–3", "rest": "90s+" }, "defaultSets": 3, "note": "Contract the glutes hard." }
        ]
      },
      {
        "id": "fs-p2",
        "name": "Front Split Phase 2",
        "equipment": "A bench or box. Dumbbells or weights. Blocks or supports.",
        "exercises": [
          { "key": "fs-p2-leg-elevated-pike-lift", "order": "A1", "name": "Leg Elevated Pike Lift", "inputType": "check", "prescription": { "reps": "6", "tempo": "5s contract / 5s relax / 5s antagonist", "sets": "2–3", "rest": "60s+" }, "defaultSets": 3, "measurement": { "type": "text", "label": "Depth" }, "note": "1 rep = push heel down 5s, relax 5s, lift leg off box 5s, repeat. Find a height where the leg can only lift 2–5cm without either of your knees bending." },
          { "key": "fs-p2-hips-high-low-couch", "order": "B1", "name": "Hips High to Hips Low Couch Stretch", "inputType": "check", "prescription": { "reps": "8", "tempo": "2310", "sets": "2–3", "rest": "60s+" }, "defaultSets": 3, "note": "Keep torso upright or slightly back. You can elevate the back knee if you feel a stretch in the front leg getting in the way." },
          { "key": "fs-p2-passive-front-split", "order": "C1", "name": "Passive Front Split — Hands Supporting", "inputType": "check", "prescription": { "reps": "30s+", "tempo": "—", "sets": "2–3", "rest": "90s+" }, "defaultSets": 3, "measurement": { "type": "text", "label": "Depth" }, "note": "Use your hands and blocks to support the position. Get yourself comfortable in the setup to be able to push the stretch." },
          { "key": "fs-p2-standing-needle", "order": "C2", "name": "Standing Needle", "inputType": "check", "prescription": { "reps": "8", "tempo": "1114", "sets": "2–3", "rest": "90s+" }, "defaultSets": 3, "note": "Be strict with your position. Fight to hold the position." }
        ]
      }
    ]
  }
}
